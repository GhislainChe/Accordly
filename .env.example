# Public configuration bundled into browser code. Copy to .env.local.
# Use your Supabase project URL and publishable key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only restricted PostgreSQL gateway. Provision externally; no real value.
# URL username must be accordly_gateway (or its Supavisor project-qualified form).
# Do not add sslmode/options query parameters; TLS verification is enforced.
ACCORDLY_DATABASE_URL=
# Optional PEM CA for a private/development PostgreSQL certificate authority.
ACCORDLY_DATABASE_CA_PEM=
# Exact public application origin, with no path/trailing slash.
ACCORDLY_APP_ORIGIN=
# Development only, loopback only, forbidden in NODE_ENV=production.
ACCORDLY_DATABASE_ALLOW_LOCAL_PLAINTEXT=false
# Supabase service-role/secret keys are not used by the runtime gateway.
# Signing is disabled by default. Only local-test is implemented; it requires
# loopback Auth/database/application origins and synthetic example.test recipients.
ACCORDLY_SIGNING_MODE=disabled
# Distinct random 32-byte base64url server keys, provision outside source control.
ACCORDLY_CHALLENGE_HMAC_KEY=
ACCORDLY_CHALLENGE_KEY_ID=
ACCORDLY_SIGNING_RATE_KEY=
# Absolute private directory for local synthetic OTP deliveries. No HTTP access.
ACCORDLY_LOCAL_MAILBOX=

# Account registration/recovery remain local-only until production Auth email,
# CAPTCHA/native rate limits, trusted ingress and recovery operations are reviewed.
ACCORDLY_ACCOUNTS_MODE=disabled
# Distinct random 32-byte base64url key, server-only; provision externally.
ACCORDLY_AUTH_RATE_KEY=
